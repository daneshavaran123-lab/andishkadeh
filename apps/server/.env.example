# --- Database (PostgreSQL 14+) ---
DATABASE_URL="postgresql://andishkadeh:CHANGE_ME@localhost:5432/andishkadeh?schema=public"

# --- HTTP ---
PORT=3000
# Comma separated origins allowed to call the API from a browser (admin panel, kiosk dev web mode).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Behind a reverse proxy (IIS/nginx) terminating TLS, set to 1 so client IPs are logged correctly.
TRUST_PROXY=0

# --- Admin authentication ---
# Long random string (≥ 32 chars). Rotating it signs every admin out.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# Admin session lifetime in hours.
ADMIN_SESSION_HOURS=8
# Failed logins before temporary lock, and lock duration in minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Media storage (uploaded images) ---
MEDIA_DIR="./storage/media"
MEDIA_MAX_MB=8
# Public base URL the kiosk uses to download media (no trailing slash).
PUBLIC_BASE_URL="http://localhost:3000"

# --- Seed only (first install) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SEED_DEVICE_ID=KIOSK-01
# API key the kiosk will use. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEED_DEVICE_KEY="CHANGE_ME_DEVICE_KEY"

# --- Admin panel (optional single-origin hosting) ---
# Path to the built admin panel (pnpm --filter @andishkadeh/admin build → apps/admin/dist).
# When set, the panel is served at http://<server>/admin/ and no CORS origin is needed for it.
ADMIN_DIST_DIR=""
