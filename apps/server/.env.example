# --- Database (PostgreSQL 14+) ---
DATABASE_URL="postgresql://andishkadeh:CHANGE_ME@localhost:5432/andishkadeh?schema=public"

# --- HTTP ---
PORT=3000
# Comma separated origins allowed to call the API from a browser (admin panel, kiosk dev web mode).
# Android kiosk app: add https://localhost (the app's own origin inside its WebView).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Behind a reverse proxy (IIS/nginx) terminating TLS, set to 1 so client IPs are logged correctly.
TRUST_PROXY=0

# --- Admin authentication ---
# Long random string (≥ 32 chars). Rotating it signs every admin out.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# Admin session lifetime in hours.
ADMIN_SESSION_HOURS=8
# Failed logins before temporary lock, and lock duration in minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Media storage (uploaded images) ---
MEDIA_DIR="./storage/media"
MEDIA_MAX_MB=8
# Public base URL the kiosk uses to download media (no trailing slash).
PUBLIC_BASE_URL="http://localhost:3000"

# With NODE_ENV=production the server refuses to start while JWT_SECRET, DATABASE_URL or
# PUBLIC_BASE_URL (must be https://) still hold example values. Docker / Liara: docs/liara-deploy.md.

# --- Seed only (first install) ---
# Initial passwords are only read while those accounts do not exist yet; remove them after the first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
# Optional test kiosk; in production register kiosks in the panel instead (the key is shown once).
SEED_DEVICE_ID=KIOSK-01
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEED_DEVICE_KEY="CHANGE_ME_DEVICE_KEY"

# --- Admin panel (optional single-origin hosting) ---
# Path to the built admin panel (pnpm --filter @andishkadeh/admin build → apps/admin/dist).
# When set, the panel is served at http://<server>/admin/ and no CORS origin is needed for it.
ADMIN_DIST_DIR=""

# --- Kiosk web app (optional, browser / tablet kiosks) ---
# Path to the built kiosk web app (pnpm --filter @andishkadeh/kiosk build:web → apps/kiosk/dist-web).
# When set, the kiosk runs in a browser at http://<server>/kiosk/ (same origin, no CORS needed).
KIOSK_WEB_DIST_DIR=""

# --- Windows kiosk installer link in the panel (optional) ---
# Default: the installer of this release on GitHub. Set to host it elsewhere.
KIOSK_INSTALLER_URL=""
