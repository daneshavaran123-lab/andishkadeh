{
  "name": "@andishkadeh/kiosk",
  "version": "1.3.0",
  "private": true,
  "description": "کیوسک سلف‌سرویس ۴۳ اینچ عمودی اندیشکده کشتی ایران (Electron + React)",
  "author": "Andishkadeh Koshti Iran",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:web": "concurrently -k -n bridge,ui \"pnpm run bridge\" \"vite --port 5174\"",
    "bridge": "tsx src/dev-bridge/server.ts",
    "dev:app": "vite --mode web --port 5176",
    "build:renderer": "vite build",
    "build:web": "vite build --mode web",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "start:electron": "electron .",
    "dist:win": "pnpm run build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "android:sync": "pnpm run build:web && cap sync android",
    "android:apk": "pnpm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@andishkadeh/shared": "workspace:*",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.4",
    "dotenv": "16.6.1",
    "electron": "42.11.9",
    "electron-builder": "26.17.0",
    "electron-builder-squirrel-windows": "26.17.0",
    "esbuild": "0.25.10",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.14.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vazirmatn": "33.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  }
}
