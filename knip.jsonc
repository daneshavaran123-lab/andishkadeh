{
  // Dead-code check (pnpm knip): unused files, exports and dependencies across the workspace.
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // An export also used inside its own file is not dead code.
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/kiosk": {
      // Bundled by scripts/build-electron.mjs, which knip does not read; the fake terminal helper is started by its test.
      "entry": ["electron/main.ts", "electron/preload.ts", "test/fixtures/*.mjs"],
      // Read as text by vite.config.ts (the service worker is generated from it).
      "ignore": ["src/renderer/sw-template.js"],
      // electron-builder loads the Squirrel plugin by name; tools/uml/render.sh uses the Vazirmatn TTF files.
      "ignoreDependencies": ["electron-builder-squirrel-windows", "vazirmatn"]
    },
    "e2e": {
      // The Playwright plugin would execute playwright.config.ts, which needs a database URL; list the entries instead.
      // scripts/*.mjs are started by its webServer commands.
      "playwright": false,
      "entry": ["playwright.config.ts", "tests/**/*.spec.ts", "scripts/*.mjs"]
    }
  }
}
