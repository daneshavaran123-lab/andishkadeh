{
  "name": "andishkadeh",
  "version": "1.7.1",
  "private": true,
  "description": "اندیشکده کشتی ایران — کیوسک سلف‌سرویس، پنل مدیریت و سرور",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @andishkadeh/shared run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --filter \"!@andishkadeh/e2e\" run test",
    "lint": "eslint .",
    "knip": "knip",
    "version:check": "node tools/release/version.mjs",
    "version:set": "node tools/release/version.mjs set",
    "db:migrate": "pnpm --filter @andishkadeh/server run db:migrate",
    "db:seed": "pnpm --filter @andishkadeh/server run db:seed",
    "dev:server": "pnpm --filter @andishkadeh/server run dev",
    "dev:admin": "pnpm --filter @andishkadeh/admin run dev",
    "dev:kiosk": "pnpm --filter @andishkadeh/kiosk run dev:web",
    "e2e": "pnpm --filter @andishkadeh/e2e run test",
    "docs:uml": "bash tools/uml/render.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.38.0",
    "typescript-eslint": "8.71.0"
  }
}
