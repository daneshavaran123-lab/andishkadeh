@startuml 05-background-sync
!include style.iuml
title نمودار فعالیت ۵ — همگام‌سازی پس‌زمینه کیوسک

|کیوسک|
start
:اجرای برنامه;
:استعلام پرداخت‌های ناتمام (بازیابی پس از قطع برق);
:چرخه اول: ارسال، سپس دریافت\nو سپس heartbeat;
fork
  while (برنامه در حال اجراست؟) is (هر pushSec)
    :ارسال رویدادهای صف به sync/push;
    note left
      سرور هر رویداد را با eventId یکتا اعمال می‌کند؛
      سفارش آفلاین با (شناسه دستگاه، شناسه محلی) ثبت می‌شود
      و ارسال دوباره تکراری نمی‌سازد.
    end note
    :پذیرفته = خارج از صف\nقابل تکرار = تأخیر\nردشده = نمایش در پنل;
  endwhile (بستن برنامه)
fork again
  while (برنامه در حال اجراست؟) is (هر pullSec)
    :دریافت کاتالوگ، تنظیمات\nو تغییرات اشتراک‌ها;
    :دانلود تصاویر جدید و بررسی sha256;
  endwhile (بستن برنامه)
fork again
  while (برنامه در حال اجراست؟) is (هر heartbeatSec)
    :ارسال نسخه، تجهیزات، صف\nو پرداخت‌های نامشخص;
    :اجرای فرمان‌های پنل\nو دریافت فوری اگر کاتالوگ تغییر کرده;
  endwhile (بستن برنامه)
fork again
  while (برنامه در حال اجراست؟) is (هر recoverySec)
    :استعلام پرداخت‌های IN_FLIGHT و UNKNOWN;
  endwhile (بستن برنامه)
end fork
stop
@enduml
