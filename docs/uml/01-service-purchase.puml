@startuml 01-service-purchase
!include style.iuml
title نمودار فعالیت ۱ — خرید خدمات

|مشتری|
start
:لمس «شروع» و انتخاب «خرید خدمات»;
repeat
  :انتخاب حوزه، زیرگروه و خدمت;
  :افزودن به سبد یا تغییر تعداد;
repeat while (خدمت دیگری لازم است؟) is (بله) not (خیر)
:مرور سبد و «ادامه»;
:وارد کردن شماره موبایل با صفحه‌کلید عددی;

|کیوسک|
:اعتبارسنجی شماره و ساخت شناسه محلی سفارش;
:درخواست ثبت سفارش از سرور;
if (سرور پاسخ داد؟) then (بله)
  |سرور|
  :قیمت‌گذاری با تعرفه و تخفیف روز\nو قفل مبلغ (LOCKED);
  if (همه اقلام قابل فروش هستند؟) then (خیر)
    |کیوسک|
    :نمایش اقلام غیرقابل فروش\nو بازگشت به سبد;
    stop
  else (بله)
  endif
else (خیر — قطع شبکه)
  |کیوسک|
  if (فروش آفلاین مجاز و کاتالوگ تازه است؟) then (بله)
    :قیمت‌گذاری با کاتالوگ ذخیره‌شده\nسفارش OFF-دستگاه-شماره;
  else (خیر)
    :پیام «فروش موقتاً ممکن نیست»;
    stop
  endif
endif

|کیوسک|
:تأیید نهایی با مبلغ قفل‌شده\n(اگر قیمت تغییر کرده، به مشتری اعلام می‌شود);

|مشتری|
if (پرداخت را تأیید می‌کند؟) then (بله)
  |کیوسک|
  repeat
    :پرداخت با کارتخوان\n(نمودار فعالیت ۳);
  repeat while (ناموفق و مشتری «تلاش دوباره» را زد؟) is (بله) not (خیر)
  switch (نتیجه پرداخت؟)
  case (پرداخت شد)
    fork
      :چاپ رسید;
    fork again
      :گزارش نتیجه و چاپ به سرور\nیا ثبت در صف رویداد;
    end fork
  case (ناموفق)
    :لغو سفارش قفل‌شده;
  case (نامشخص)
    :استعلام از کارتخوان\n(تلاش دوباره ممنوع);
    :راهنمای پیگیری با شماره سفارش;
  endswitch
else (انصراف)
  |کیوسک|
  :لغو سفارش قفل‌شده;
endif

|کیوسک|
:صفحه پایان، پاک شدن نشست\nو بازگشت خودکار به شروع;
stop
@enduml
