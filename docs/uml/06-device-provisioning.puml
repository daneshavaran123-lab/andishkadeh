@startuml 06-device-provisioning
!include style.iuml
title نمودار فعالیت ۶ — راه‌اندازی و ثبت دستگاه کیوسک

|مدیر اصلی|
start
if (کیوسک تازه؟) then (بله)
  :در /kiosk یا پنل، بخش «کیوسک‌ها»:\n«ثبت کیوسک جدید» فقط با نام;
  |سرور|
  :شناسه KIOSK-NN آزاد بعدی\nو کلید تصادفی (فقط هش sha256);
else (نه — اتصال دوباره یا تعویض دستگاه)
  |مدیر اصلی|
  :«کد فعال‌سازی» روی کارت همان کیوسک;
endif
|سرور|
:کد فعال‌سازی ۸ رقمی، ۳۰ دقیقه\nو یک‌بارمصرف (فقط هش sha256);

|مدیر اصلی|
:پنجره «اتصال کیوسک»:\nکد، لینک /?activate=کد و QR آن;

|تکنسین|
repeat
  switch (نسخه کیوسک؟)
  case (ویندوز یا اندروید)
    :صفحه راه‌اندازی (آدرس سرور از پیش پر):\nکد با صفحه‌کلید روی صفحه یا اسکن QR;
  case (تبلت یا مرورگر)
    :باز کردن لینک یا QR روی همان دستگاه\nو «فعال‌سازی این دستگاه»;
  endswitch
  |کیوسک|
  :POST /kiosk/activate با کد;
  |سرور|
  :کد درست، در مهلت و استفاده‌نشده؟\nتلاش نادرست برای هر IP محدود;
repeat while (پذیرفته نشد؟) is (بله — کد تازه از پنل) not (خیر)

|سرور|
:کلید تازه دستگاه (کلید قبلی باطل)\nو پاک شدن کد;

|کیوسک|
:ذخیره شناسه و کلید روی دستگاه;
:دریافت کاتالوگ، تنظیمات و تصاویر;
:اولین heartbeat: نسخه و وضعیت تجهیزات;

|مدیر اصلی|
:مشاهده دستگاه «آنلاین» و وضعیت تجهیزات;
note right
  روش دستی: شناسه و کلید (پنجره ثبت یا «کلید جدید»)
  در صفحه راه‌اندازی یا kiosk.config.json.
  «کلید جدید»: کلید قبلی فوراً باطل می‌شود.
  «غیرفعال‌سازی»: همه درخواست‌های دستگاه رد می‌شوند.
end note
stop
@enduml
