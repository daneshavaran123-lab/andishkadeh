@startuml 04-member-qr-check
!include style.iuml
title نمودار فعالیت ۴ — ورود اعضا و بررسی کارت QR

|عضو|
start
:انتخاب «ورود اعضا»;
:نگه داشتن کارت QR جلوی اسکنر;

|کیوسک|
:دریافت کد از اسکنر و پاک‌سازی ورودی;
:ارسال کد به سرور برای بررسی;
if (سرور پاسخ داد؟) then (بله)
  |سرور|
  :بررسی هش توکن، دوره و وضعیت اشتراک;
  :ثبت سابقه بررسی;
else (خیر — قطع شبکه)
  |کیوسک|
  if (بررسی آفلاین مجاز است؟) then (بله)
    :جست‌وجوی هش توکن در کش اشتراک‌ها\nبا همان قواعد سرور;
    :ثبت رویداد ACCESS_LOG در صف;
  else (خیر)
    :پیام «بررسی اعتبار فعلاً ممکن نیست»;
    stop
  endif
endif

|کیوسک|
switch (نتیجه؟)
case (فعال)
  :نمایش «فعال» با تاریخ پایان\nو ۴ رقم آخر موبایل;
case (منقضی)
  :تاریخ پایان و پیشنهاد خرید پلن جدید;
case (شروع‌نشده)
  :تاریخ شروع اشتراک;
case (باطل یا نامعتبر)
  :پیام بدون افشای اطلاعات شخصی;
endswitch
:بازگشت خودکار به شروع;
stop
@enduml
