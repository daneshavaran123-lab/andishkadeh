@startuml 09-session-timeout
!include style.iuml
title نمودار فعالیت ۹ — مهلت بی‌فعالیتی و پایان نشست

|کیوسک|
start
:شروع نشست با لمس «شروع»;
while (نشست فعال است؟) is (بله)
  if (صفحه پرداخت، چاپ یا پایان، بدون پیام خطا؟) then (بله)
    :مهلت بی‌فعالیتی اعمال نمی‌شود;
  else (خیر)
    if (بی‌فعالیتی به sessionTimeoutSec منهای timeoutWarningSec رسید؟) then (بله)
      :نمایش «هنوز اینجا هستید؟»\nبا شمارش معکوس;
      |مشتری|
      if (لمس صفحه یا «ادامه می‌دهم»؟) then (بله)
        |کیوسک|
        :ادامه نشست؛ شمارش از نو;
      else (خیر — پایان شمارش)
        |کیوسک|
        break
      endif
    else (خیر)
    endif
  endif
endwhile (پایان خرید یا انصراف)

|کیوسک|
if (سفارش قفل‌شده پرداخت‌نشده وجود دارد؟) then (بله)
  :لغو سفارش;
else (خیر)
endif
:پاک شدن توکن خام QR\nو ماسک شدن شماره موبایل سفارش‌های ثبت‌شده;
:پاک شدن سبد و اطلاعات مشتری از رابط;
:بازگشت به صفحه شروع;
note right
  پاسخی که پس از پایان نشست برسد
  (بررسی QR، ثبت سفارش، استعلام، چاپ)
  نمایش داده نمی‌شود
end note
stop
@enduml
