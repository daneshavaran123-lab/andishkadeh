@startuml 03-card-payment
!include style.iuml
title نمودار فعالیت ۳ — پرداخت با کارتخوان، ژورنال و بازیابی

|هسته کیوسک|
start
if (سفارش قابل پرداخت است؟\n(LOCKED یا FAILED، بدون تلاش نامشخص یا در جریان)) then (خیر)
  :رد درخواست\n(PAYMENT_UNRESOLVED یا PAYMENT_IN_PROGRESS);
  stop
else (بله)
endif
if (کارتخوان متصل است؟) then (خیر)
  :رد: کارتخوان در دسترس نیست;
  stop
else (بله)
endif

|پایگاه محلی|
:ثبت ژورنال IN_FLIGHT با attemptId;
:ذخیره قطعی (flush);
note right
  اگر از اینجا به بعد برق قطع شود،
  پس از راه‌اندازی این تلاش استعلام می‌شود
end note

|هسته کیوسک|
if (سفارش آنلاین است؟) then (بله)
  |سرور|
  :ثبت تلاش پرداخت (payments/initiate);
  if (سرور درخواست را رد کرد؟) then (بله)
    |پایگاه محلی|
    :حذف ردیف ژورنال;
    |هسته کیوسک|
    :نمایش علت\n(کارتخوان استفاده نشد);
    stop
  else (خیر یا قطع شبکه)
  endif
else (آفلاین)
  |هسته کیوسک|
  :ثبت رویداد ORDER_OFFLINE در صف;
endif

|کارتخوان|
:دریافت مبلغ، شماره سفارش و attemptId;
:کشیدن کارت و وارد کردن رمز توسط مشتری;
:پاسخ PAID، FAILED یا UNKNOWN\n(پایان مهلت paymentTimeoutSec = UNKNOWN);

|پایگاه محلی|
:در یک تراکنش: ثبت نتیجه در ژورنال\nو رویداد PAYMENT_RESULT در صف;
:ذخیره قطعی (flush);

|هسته کیوسک|
if (سفارش روی سرور ثبت شده و سرور در دسترس است؟) then (بله)
  |سرور|
  :ثبت نتیجه و به‌روزرسانی سفارش;
  |هسته کیوسک|
  :رویداد صف «انجام‌شده»;
else (خیر)
  |هسته کیوسک|
  :رویداد در صف می‌ماند\nسفارش «در انتظار همگام‌سازی»;
endif

|هسته کیوسک|
if (نتیجه نامشخص است؟) then (بله)
  :استعلام خودکار در شروع برنامه، هر recoverySec\nو با فرمان PAYMENT_INQUIRY از پنل;
else (خیر)
endif
:نمایش نتیجه به مشتری;
stop
@enduml
