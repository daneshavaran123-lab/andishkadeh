' Shared look of the UML activity diagrams (PlantUML). Font: Vazirmatn (install the TTF to render).
skinparam defaultFontName Vazirmatn
skinparam defaultFontSize 14
skinparam dpi 140
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam roundCorner 14
skinparam ArrowColor #33415C
skinparam ArrowFontSize 12
skinparam ArrowFontColor #33415C
skinparam ActivityBackgroundColor #EEF4FD
skinparam ActivityBorderColor #1464D0
skinparam ActivityBorderThickness 1.2
skinparam ActivityDiamondBackgroundColor #FFF4DD
skinparam ActivityDiamondBorderColor #9A5C00
skinparam ActivityDiamondFontSize 13
skinparam ActivityStartColor #0D1A2D
skinparam ActivityEndColor #0D1A2D
skinparam ActivityBarColor #0D1A2D
skinparam SwimlaneBorderColor #9AA7BD
skinparam SwimlaneBorderThickness 1
skinparam SwimlaneTitleFontSize 16
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleFontColor #0D1A2D
skinparam NoteBackgroundColor #FBF1E1
skinparam NoteBorderColor #9A5C00
skinparam NoteFontSize 12
skinparam TitleFontSize 19
skinparam TitleFontStyle bold
skinparam TitleFontColor #0D1A2D
